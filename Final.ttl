:Agent rdfs:comment "An autonomous entity capable of having roles, goals, and capabilities within a hybrid intelligence system."@en ;
        rdfs:label "Agent"@en .


:ArtificialAgent rdfs:comment "An artificial or computational agent (robot, software, etc.) collaborating with human agents."@en ;
                 rdfs:label "Artificial Agent"@en .


:BadOutcome rdfs:label "Bad outcome"@en .


:Context rdfs:comment "Situational conditions (environmental, cultural, cognitive) under which tasks and evaluations occur."@en ;
         rdfs:label "Context"@en .


:Domain rdfs:comment "A domain of application or knowledge relevant to a use case."@en ;
        rdfs:label "Domain"@en .


:Evaluation rdfs:comment "A process of assessing the quality or outcome of executions, methods, or goals."@en ;
            rdfs:label "Evaluation"@en .


:Experiment rdfs:comment "An empirical setup linked to an evaluation that tests metrics and hypotheses."@en ;
            rdfs:label "Experiment"@en .


:GoodOutcome rdfs:label "Good outcome"@en .


:HumanAgent rdfs:comment "A human participant in the hybrid intelligence system, possessing cognitive and perceptual abilities."@en ;
            rdfs:label "Human Agent"@en .


:Interaction rdfs:comment "A multi-agent task execution where two or more agents coordinate (verbal, symbolic, or physical) toward a goal."@en ;
             rdfs:label "Interaction"@en .


:Method rdfs:comment "A method or approach used in task execution or modeling."@en ;
        rdfs:label "Method"@en .


:MixedOutcome rdfs:label "Mixed outcome"@en .


:Model rdfs:comment "A computational model (e.g., a language model) used by an agent during task execution."@en ;
       rdfs:label "Model"@en .


