@prefix : <http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/> .

<https://w3id.org/hi-ontology#> rdf:type owl:Ontology ;
                                 owl:imports <http://www.w3.org/ns/prov#> ;
                                 <http://purl.org/dc/elements/1.1/description> "Conceptual model of Hybrid Intelligence: agents, teams, goals, tasks, capabilities, methods, evaluations, context, and ethical phenomena."@en ;
                                 <http://purl.org/dc/elements/1.1/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                 <http://purl.org/dc/elements/1.1/title> "The Hybrid Intelligence (HI) Ontology"@en ;
                                 <http://purl.org/dc/terms/created> "2025-10-01"^^xsd:date ;
                                 <http://purl.org/vocab/vann/preferredNamespacePrefix> "hi" ;
                                 <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/hi-ontology#" ;
                                 owl:versionInfo "2.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/license
<http://purl.org/dc/elements/1.1/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://schema.org/name
<http://schema.org/name> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#exactCardinality
owl:exactCardinality rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/allowsTask
:allowsTask rdf:type owl:ObjectProperty ;
            owl:inverseOf :requiresCapability ;
            rdfs:domain :Capability ;
            rdfs:range :Task ;
            rdfs:comment "A capability enables or allows a task to be performed."@en ;
            rdfs:label "allows task" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/collaboratesWith
:collaboratesWith rdf:type owl:ObjectProperty ,
                           owl:SymmetricProperty ;
                  rdfs:domain :Agent ;
                  rdfs:range :Agent ;
                  rdfs:label "collaborates with" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/evaluatedBy
:evaluatedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :TaskExecution ;
             rdfs:range :Evaluation ;
             rdfs:comment "Execution is evaluated by a defined evaluation."@en ;
             rdfs:label "evaluated by" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/executesTask
:executesTask rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :isAssignedToTask ;
              rdfs:domain :Agent ;
              rdfs:range :Task ;
              owl:propertyChainAxiom ( :performsExecution
                                       :realizesTask
                                     ) ;
              rdfs:comment "Agent executes a task (derivable from Agent→Execution→Task)."@en ;
              rdfs:label "executes task" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/generatesRecommendation
:generatesRecommendation rdf:type owl:ObjectProperty ;
                         rdfs:domain :ArtificialAgent ;
                         rdfs:range :Recommendation .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasAgentConcept
:hasAgentConcept rdf:type owl:ObjectProperty ;
                 rdfs:domain :Agent ;
                 rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                 rdfs:comment "Links an agent to a concept in the HINT thesaurus."@en ;
                 rdfs:label "has agent concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasAgentInvolved
:hasAgentInvolved rdf:type owl:ObjectProperty ;
                  rdfs:domain :Interaction ;
                  rdfs:range :Agent ;
                  rdfs:comment "Indicates an agent that participates in or contributes to an interaction episode. This property identifies the human or artificial agents involved in the exchange."@en ;
                  rdfs:label "has agent involved" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasAgreementLevel
:hasAgreementLevel rdf:type owl:ObjectProperty ;
                   rdfs:domain :Interaction ;
                   rdfs:range :AgreementLevel .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasAutonomyLevel
:hasAutonomyLevel rdf:type owl:ObjectProperty ;
                  rdfs:domain :Interaction ;
                  rdfs:range :AutonomyLevel .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasCapability
:hasCapability rdf:type owl:ObjectProperty ;
               rdfs:domain :Agent ;
               rdfs:range :Capability ;
               rdfs:comment "Agent possesses a capability."@en ;
               rdfs:label "has capability" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasCapabilityConcept
:hasCapabilityConcept rdf:type owl:ObjectProperty ;
                      rdfs:domain :Capability ;
                      rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                      rdfs:comment "Links a capability to a concept in the HINT thesaurus."@en ;
                      rdfs:label "has capability concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasConstraintConcept
:hasConstraintConcept rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :Agent
                                                  :Context
                                                  :HITeam
                                                )
                                  ] ;
                      rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                      rdfs:comment "Specifies the constraint using a concept in the HINT thesaurus."@en ;
                      rdfs:label "has constraint concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasContext
:hasContext rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasContextConcept
:hasContextConcept rdf:type owl:ObjectProperty ;
                   rdfs:domain :Context ;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                   rdfs:comment "Links a context to a concept in the HINT thesaurus."@en ;
                   rdfs:label "has context concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasDomain
:hasDomain rdf:type owl:ObjectProperty ;
           rdfs:domain :UseCase ;
           rdfs:range :Domain ;
           rdfs:comment "Links a use case to a domain."@en ;
           rdfs:label "has domain" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasDomainConcept
:hasDomainConcept rdf:type owl:ObjectProperty ;
                  rdfs:domain :Domain ;
                  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                  rdfs:comment "Links a domain to a concept in the HINT thesaurus."@en ;
                  rdfs:label "has domain concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasEvaluationConcept
:hasEvaluationConcept rdf:type owl:ObjectProperty ;
                      rdfs:domain :Evaluation ;
                      rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                      rdfs:comment "Links an evaluation to a concept in the HINT thesaurus."@en ;
                      rdfs:label "has evaluation concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasExecutionConcept
:hasExecutionConcept rdf:type owl:ObjectProperty ;
                     rdfs:domain :TaskExecution ;
                     rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                     rdfs:comment "Links an experiment to a concept in the HINT thesaurus."@en ;
                     rdfs:label "has execution concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasExperiment
:hasExperiment rdf:type owl:ObjectProperty ;
               rdfs:domain :Evaluation ;
               rdfs:range :Experiment ;
               rdfs:comment "An evaluation has an experiment."@en ;
               rdfs:label "has experiment" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasExperimentConcept
:hasExperimentConcept rdf:type owl:ObjectProperty ;
                      rdfs:domain :Experiment ;
                      rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                      rdfs:comment "Links an experiment to a concept in the HINT thesaurus."@en ;
                      rdfs:label "has experiment concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasExplainabilityLevel
:hasExplainabilityLevel rdf:type owl:ObjectProperty ;
                        rdfs:domain :Interaction ;
                        rdfs:range :ExplainabilityLevel .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasGoal
:hasGoal rdf:type owl:ObjectProperty ;
         rdfs:domain :HITeam ;
         rdfs:range :Goal ;
         rdfs:comment "An HI team pursues one or more goals."@en ;
         rdfs:label "has goal" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasGoalConcept
:hasGoalConcept rdf:type owl:ObjectProperty ;
                rdfs:domain :Goal ;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                rdfs:comment "Links a goal to a concept in the HINT thesaurus."@en ;
                rdfs:label "has goal concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasHITeam
:hasHITeam rdf:type owl:ObjectProperty ;
           rdfs:domain :UseCase ;
           rdfs:range :HITeam ;
           rdfs:comment "A use case introduces a hybrid intelligence team."@en ;
           rdfs:label "has HI team" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasInfluenceOn
:hasInfluenceOn rdf:type owl:ObjectProperty ;
                owl:inverseOf :isInfluencedBy ;
                rdfs:domain :Context ;
                rdfs:range :HITeam ;
                rdfs:comment "Relates a contextual condition to the HI team whose actions, collaboration dynamics, or task performance are influenced by that condition. It captures how background phenomena and constraints shape the team's operation in a given use case."@en ;
                rdfs:label "has influence on" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasInputData
:hasInputData rdf:type owl:ObjectProperty ;
              rdfs:domain :Model ,
                          :TaskExecution ;
              rdfs:range :Data ;
              rdfs:comment "A model or task execution takes specific input data."@en ;
              rdfs:label "has input data" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasInteractionEpisode
:hasInteractionEpisode rdf:type owl:ObjectProperty ;
                       rdfs:domain :TaskExecution ;
                       rdfs:range :Interaction ;
                       rdfs:comment "Identifies moments of interaction (e.g., dialogue, negotiation, or guidance) that unfold within the execution of a task."@en ;
                       rdfs:label "has interaction episode" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasInteractionIntentConcept
:hasInteractionIntentConcept rdf:type owl:ObjectProperty ;
                             rdfs:domain :Interaction ;
                             rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                             rdfs:comment "Intent underlying the interaction (e.g., explain, request, negotiate)."@en ;
                             rdfs:label "has interaction intent concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasInteractionModalityConcept
:hasInteractionModalityConcept rdf:type owl:ObjectProperty ;
                               rdfs:domain :Interaction ;
                               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                               rdfs:comment "Modality/channel used during the interaction."@en ;
                               rdfs:label "has interaction modality concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasMember
:hasMember rdf:type owl:ObjectProperty ;
           rdfs:domain :HITeam ;
           rdfs:range :Agent ;
           rdfs:comment "Specifies agents that are members of an HI team."@en ;
           rdfs:label "has member" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasMethod
:hasMethod rdf:type owl:ObjectProperty ;
           rdfs:domain :Model ;
           rdfs:range :Method ;
           rdfs:comment "A model uses a specific method."@en ;
           rdfs:label "has method" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasMethodConcept
:hasMethodConcept rdf:type owl:ObjectProperty ;
                  rdfs:domain :Method ;
                  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                  rdfs:comment "Links a task execution to a method in the HINT thesaurus."@en ;
                  rdfs:label "has method concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasMetricConcept
:hasMetricConcept rdf:type owl:ObjectProperty ;
                  rdfs:domain :Evaluation ,
                              :Metric ;
                  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                  rdfs:comment "An evaluation uses certain metrics, defined in the HINT thesaurus"@en ,
                               "Links a metric to a concept in the HINT thesaurus."@en ;
                  rdfs:label "has metric concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasMetricTested
:hasMetricTested rdf:type owl:ObjectProperty ;
                 rdfs:domain :Experiment ;
                 rdfs:range :Metric ;
                 rdfs:comment "An experiment tests certain metrics."@en ;
                 rdfs:label "has metric tested" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasOutcomeQuality
:hasOutcomeQuality rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Interaction ;
                   rdfs:range :OutcomeQuality .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasOutputData
:hasOutputData rdf:type owl:ObjectProperty ;
               rdfs:domain :Model ,
                           :TaskExecution ;
               rdfs:range :Data ;
               rdfs:comment "A model or task execution produces specific output data."@en ;
               rdfs:label "has output data" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasPhenomenonConcept
:hasPhenomenonConcept rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :Agent
                                                  :Context
                                                  :HITeam
                                                )
                                  ] ;
                      rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                      rdfs:comment "Context exhibits a phenomenon (e.g., bias/feedback emerges in that context)."@en ;
                      rdfs:label "has phenomenon concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasRoleConcept
:hasRoleConcept rdf:type owl:ObjectProperty ;
                rdfs:domain :Agent ;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                rdfs:comment "Links a role to a concept in the HINT thesaurus."@en ;
                rdfs:label "has role concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasTaskConcept
:hasTaskConcept rdf:type owl:ObjectProperty ;
                rdfs:domain :Task ;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                rdfs:comment "Links a task to a concept in the HINT thesaurus."@en ;
                rdfs:label "has task concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasUseCaseConcept
:hasUseCaseConcept rdf:type owl:ObjectProperty ;
                   rdfs:domain :UseCase ;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                   rdfs:comment "Links a use case to a concept in the HINT thesaurus."@en ;
                   rdfs:label "has use case concept" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/influences
:influences rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain :Entity ;
            rdfs:range :Entity ;
            rdfs:label "influences" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/isAssignedToTask
:isAssignedToTask rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :isEligibleForTask ;
                  rdfs:domain :Agent ;
                  rdfs:range :Task ;
                  owl:propertyChainAxiom ( :performsExecution
                                           :realizesTask
                                         ) ;
                  rdfs:comment "Relates an agent to a task that it is formally assigned to perform. Every assignment implies that the agent is eligible for that task."@en ;
                  rdfs:label "is assigned to task" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/isEligibleForTask
:isEligibleForTask rdf:type owl:ObjectProperty ;
                   rdfs:domain :Agent ;
                   rdfs:range :Task ;
                   owl:propertyChainAxiom ( :hasCapability
                                            :allowsTask
                                          ) ;
                   rdfs:comment "Relates an agent to a task it is eligible to perform, based on their capabilities. Assignment is a stricter, policy-level decision that presupposes eligibility."@en ;
                   rdfs:label "is eligible for task" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/isInfluencedBy
:isInfluencedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :HITeam ;
                rdfs:range :Context ;
                rdfs:comment "Related a HI Team to the contextual condition that affects its actions, collaboration dynamics, or task performance."@en ;
                rdfs:label "is influenced by" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/makesDecision
:makesDecision rdf:type owl:ObjectProperty ;
               rdfs:domain :HumanAgent ;
               rdfs:range :Decision .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/operatesInContext
:operatesInContext rdf:type owl:ObjectProperty ;
                   rdfs:domain :Agent ;
                   rdfs:range :Context ;
                   rdfs:comment "Specifies the context in which an HI team operates."@en ;
                   rdfs:label "operates in context" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/performedBy
:performedBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :performsExecution ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :TaskExecution
                                       )
                         ] ;
             rdfs:range :Agent ;
             rdfs:comment "Execution performed by an agent."@en ;
             rdfs:label "performed by" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/performsExecution
:performsExecution rdf:type owl:ObjectProperty ;
                   rdfs:domain :Agent ;
                   rdfs:range :TaskExecution ;
                   rdfs:comment "Agent that performs a specific task execution."@en ;
                   rdfs:label "performs execution" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/providesExplanation
:providesExplanation rdf:type owl:ObjectProperty ;
                     rdfs:domain :ArtificialAgent ;
                     rdfs:range :Explanation .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/realizedBy
:realizedBy rdf:type owl:ObjectProperty ;
            owl:inverseOf :realizesTask ;
            rdfs:domain :Task ;
            rdfs:range :TaskExecution ;
            rdfs:comment "A task is realized through a task execution."@en ;
            rdfs:label "realized by" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/realizesTask
:realizesTask rdf:type owl:ObjectProperty ;
              rdfs:domain :TaskExecution ;
              rdfs:range :Task ;
              rdfs:comment "Task execution realizes a task."@en ;
              rdfs:label "realizes task" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/requiresCapability
:requiresCapability rdf:type owl:ObjectProperty ;
                    rdfs:domain :Task ;
                    rdfs:range :Capability ;
                    rdfs:comment "A task requires certain capabilities to be accomplished."@en ;
                    rdfs:label "requires cability" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/requiresTask
:requiresTask rdf:type owl:ObjectProperty ;
              rdfs:domain :Goal ;
              rdfs:range :Task ;
              rdfs:comment "A goal requires one or more tasks to be fulfilled."@en ;
              rdfs:label "has task" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/towardsGoal
:towardsGoal rdf:type owl:ObjectProperty ;
             rdfs:domain :TaskExecution ;
             rdfs:range :Goal ;
             rdfs:comment "Task execution towards a goal."@en ;
             rdfs:label "towards goal" .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/usesModel
:usesModel rdf:type owl:ObjectProperty ;
           rdfs:domain :TaskExecution ;
           rdfs:range :Model ;
           rdfs:comment "Indicates that a task execution uses a specific model (e.g., a language model developed by an organization) in its operation."@en ;
           rdfs:label "uses model" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasAlternativeHypothesis
:hasAlternativeHypothesis rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Experiment ;
                          rdfs:range rdfs:Literal ;
                          rdfs:comment "Stores the textual formulation of the alternative hypothesis of an experiment."@en ;
                          rdfs:label "has alternative hypothesis"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/hasNullHypothesis
:hasNullHypothesis rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Experiment ;
                   rdfs:range rdfs:Literal ;
                   rdfs:comment "Stores the textual formulation of the null hypothesis of an experiment."@en ;
                   rdfs:label "has null hypothesis"@en .


#################################################################
#    Classes
#################################################################

###  http://org.semanticweb.owlapi/error#Error1
<http://org.semanticweb.owlapi/error#Error1> rdf:type owl:Class .


###  http://schema.org/Organization
<http://schema.org/Organization> rdf:type owl:Class ;
                                 rdfs:comment "A Schema.org class representing an organization such as an institution, company, or group."@en ;
                                 rdfs:label "Organization"@en .


###  http://schema.org/PropertyValue
<http://schema.org/PropertyValue> rdf:type owl:Class ;
                                  rdfs:comment "A Schema.org class representing a specific property-value pair, often used for metadata or structured descriptions."@en ;
                                  rdfs:label "Property Value"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Agent
:Agent rdf:type owl:Class ;
       owl:equivalentClass <http://www.w3.org/ns/prov#Agent> .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/AgreementLevel
:AgreementLevel rdf:type owl:Class ;
                rdfs:subClassOf <http://schema.org/PropertyValue> .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/AlignedAgreement
:AlignedAgreement rdf:type owl:Class ;
                  owl:disjointWith :ConflictingAgreement ,
                                   :ForcedAgreement .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/ArtificialAgent
:ArtificialAgent rdf:type owl:Class ;
                 rdfs:subClassOf :Agent ;
                 owl:disjointWith :HumanAgent .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/AutonomyLevel
:AutonomyLevel rdf:type owl:Class ;
               rdfs:subClassOf <http://schema.org/PropertyValue> ,
                               <http://www.w3.org/ns/prov#Activity> .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/BadOutcome
:BadOutcome rdf:type owl:Class ;
            rdfs:subClassOf :OutcomeQuality ;
            owl:disjointWith :GoodOutcome ,
                             :MixedOutcome .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Capability
:Capability rdf:type owl:Class ;
            rdfs:comment "A skill, competence, or functional capacity that allows an agent to perform or enable a task."@en ;
            rdfs:label "Capability"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/ConflictingAgreement
:ConflictingAgreement rdf:type owl:Class ;
                      owl:disjointWith :ForcedAgreement .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Context
:Context rdf:type owl:Class .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Data
:Data rdf:type owl:Class ;
      rdfs:comment "Data used as input or output in models and task executions."@en ;
      rdfs:label "Data"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Decision
:Decision rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
          owl:disjointWith :Explanation ,
                           :Recommendation .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Domain
:Domain rdf:type owl:Class .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Entity
:Entity rdf:type owl:Class .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Evaluation
:Evaluation rdf:type owl:Class .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Experiment
:Experiment rdf:type owl:Class .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/ExplainabilityLevel
:ExplainabilityLevel rdf:type owl:Class ;
                     rdfs:subClassOf <http://schema.org/PropertyValue> .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Explanation
:Explanation rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/ForcedAgreement
:ForcedAgreement rdf:type owl:Class .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Goal
:Goal rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :requiresTask ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Task
                      ] ;
      rdfs:comment "A desired outcome pursued by an HI team, requiring one or more tasks to be completed."@en ;
      rdfs:label "Goal"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/GoodOutcome
:GoodOutcome rdf:type owl:Class ;
             rdfs:subClassOf :OutcomeQuality ;
             owl:disjointWith :MixedOutcome .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/HITeam
:HITeam rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :hasGoal ;
                          owl:someValuesFrom :Goal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasMember ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :ArtificialAgent
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasMember ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :HumanAgent
                        ] ;
        rdfs:comment "A hybrid intelligence team composed of human and artificial agents pursuing a shared goal."@en ;
        rdfs:label "HI Team"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/HighExplainability
:HighExplainability rdf:type owl:Class ;
                    owl:disjointWith :LowExplainability ,
                                     :MediumExplainability .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/HumanAgent
:HumanAgent rdf:type owl:Class ;
            rdfs:subClassOf :Agent ,
                            <http://xmlns.com/foaf/0.1/Person> .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Interaction
:Interaction rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasAgreementLevel ;
                               owl:allValuesFrom :AgreementLevel
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasAutonomyLevel ;
                               owl:allValuesFrom :AutonomyLevel
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasExplainabilityLevel ;
                               owl:allValuesFrom :ExplainabilityLevel
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasOutcomeQuality ;
                               owl:allValuesFrom :OutcomeQuality
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasAgentInvolved ;
                               owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                               owl:onClass :Agent
                             ] .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/LowExplainability
:LowExplainability rdf:type owl:Class ;
                   owl:disjointWith :MediumExplainability .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/MediumExplainability
:MediumExplainability rdf:type owl:Class .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Method
:Method rdf:type owl:Class .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Metric
:Metric rdf:type owl:Class ;
        rdfs:comment "A metric used for evaluating task executions or models."@en ;
        rdfs:label "Metric"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/MixedOutcome
:MixedOutcome rdf:type owl:Class ;
              rdfs:subClassOf :OutcomeQuality .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Model
:Model rdf:type owl:Class .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/OutcomeQuality
:OutcomeQuality rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:unionOf ( :BadOutcome
                                                    :GoodOutcome
                                                    :MixedOutcome
                                                  )
                                    ] ;
                rdfs:subClassOf <http://schema.org/PropertyValue> ;
                rdfs:comment "The quality of a Human-AI collaboration outcome. Every outcome must be exactly one of GoodOutcome, MixedOutcome, or BadOutcome."@en ;
                rdfs:label "Outcome quality"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Recommendation
:Recommendation rdf:type owl:Class ;
                rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/Task
:Task rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :requiresCapability ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Capability
                      ] ;
      rdfs:comment "A unit of purposeful activity executed by an agent toward achieving a goal."@en ;
      rdfs:label "Task"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/TaskExecution
:TaskExecution rdf:type owl:Class ;
               rdfs:comment "The realization or performance of a specific task by an agent using a method."@en ;
               rdfs:label "Task Execution"@en .


###  http://www.semanticweb.org/priyanshi/ontologies/2026/3/untitled-ontology-27/UseCase
:UseCase rdf:type owl:Class ;
         rdfs:comment "A structured situation describing a specific hybrid intelligence scenario (previously 'Scenario')."@en ;
         rdfs:label "Use Case"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class ;
                                              rdfs:comment "A SKOS concept representing a unit of thought, used for controlled vocabularies and thesauri."@en ;
                                              rdfs:label "Concept"@en .


###  http://www.w3.org/ns/prov#Activity
<http://www.w3.org/ns/prov#Activity> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> rdf:type owl:Class ;
                                   rdfs:comment "A human individual described using the FOAF vocabulary. Represents natural persons who may participate in, interact with, or be modeled within a Hybrid Intelligence scenario."@en ;
                                   rdfs:label "Person"@en .


